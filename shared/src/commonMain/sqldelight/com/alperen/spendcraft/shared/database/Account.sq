CREATE TABLE AccountEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    type TEXT NOT NULL DEFAULT 'CASH',
    balance INTEGER NOT NULL DEFAULT 0,
    currency TEXT NOT NULL DEFAULT 'TRY',
    color TEXT NOT NULL DEFAULT '#007AFF',
    isDefault INTEGER NOT NULL DEFAULT 0,
    archived INTEGER NOT NULL DEFAULT 0
);

selectAll:
SELECT * FROM AccountEntity;

selectById:
SELECT * FROM AccountEntity WHERE id = ?;

selectDefault:
SELECT * FROM AccountEntity WHERE isDefault = 1 LIMIT 1;

insert:
INSERT INTO AccountEntity(name, type, balance, currency, color, isDefault, archived)
VALUES (?, ?, ?, ?, ?, ?, ?);

update:
UPDATE AccountEntity
SET name = ?, type = ?, balance = ?, currency = ?, color = ?, isDefault = ?, archived = ?
WHERE id = ?;

delete:
DELETE FROM AccountEntity WHERE id = ?;

getLastInsertRowId:
SELECT last_insert_rowid();

